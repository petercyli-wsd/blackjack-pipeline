# Blackjack Pipeline with pipelines turned on, for an always-on host with a persistent disk at /data.
# (The plain Dockerfile is the free, Studio-only deployment.)
# Adds what the game's own pipeline needs: git to fetch the game repo, uv to install its Python tools
# (OpenCV, PyTorch/SAM 2 from wheels; no compilers), and the shared libraries OpenCV loads.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates git libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /uvx /usr/local/bin/
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY server.js ./
COPY src ./src
COPY public ./public
COPY pipelines ./pipelines
# Everything a run makes, and every downloaded toolchain, lives on the disk so it survives redeploys.
ENV NODE_ENV=production PORT=10000 DATA_DIR=/data PIPELINES_ENABLED=true FFMPEG_PATH=/usr/bin/ffmpeg FFPROBE_PATH=/usr/bin/ffprobe \
    UV_CACHE_DIR=/data/cache/uv UV_PYTHON_INSTALL_DIR=/data/cache/python npm_config_cache=/data/cache/npm
RUN mkdir -p /data && chown node:node /data
USER node
EXPOSE 10000
CMD ["node", "server.js"]
